FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# 👇 THIS IS THE IMPORTANT PART
ARG VITE_BACKEND_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_QUICKBOOKS_OAUTH_URL
ARG VITE_QBO_CLIENT_ID
ARG VITE_QUICKBOOKS_REDIRECT_URI

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_QUICKBOOKS_OAUTH_URL=$VITE_QUICKBOOKS_OAUTH_URL
ENV VITE_QBO_CLIENT_ID=$VITE_QBO_CLIENT_ID
ENV VITE_QUICKBOOKS_REDIRECT_URI=$VITE_QUICKBOOKS_REDIRECT_URI

RUN npm run build


FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
